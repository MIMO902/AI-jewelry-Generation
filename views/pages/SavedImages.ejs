<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jewelry Design Gallery</title>
    <link rel="stylesheet" href="/css/savedimages.css"> <!-- Link to external CSS file -->
    <link rel="stylesheet" href="/css/navbar.css">
</head>
<body>
    <%- include("../partials/navbar") %>
    <!-- HEADER -->

    <!-- MAIN CONTENT -->
    <h2>Saved Jewelry Designs</h2>
    <div class="gallery">
        
        <% if(saved){%>
            <% saved.forEach((s)=>{%>
        <!-- Example Designs -->
        <div class="design">
            <form method="post" action="/user/del_saved_design/<%=s.id%>">
                <input type="submit" class="delete-button"  value="X">
            </form>
            <img src="<%=s.imagePath%>" alt="Diamond Necklace">
            <p><%=s.prompt%></p>
            <button class="view-button">View Details</button>
        </div>
        <%})%>
        <%} else{%>
            <p>you have nothing in the wishlist</p>
            <%}%>
    </div>

    <script>
        // Function to delete a design card
        function deleteDesign(button) {
            const designCard = button.parentElement;
            const formparent = designCard.parentElement;
            formparent.remove();
        }
    </script>

</body>
</html>
