<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JewelryGen Login</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <span>&#128142;</span>
            <span>JewelryGen</span>
        </div>
        <form action="/login-action" method="post">
            <div class="input-group">
                <label for="username">Username</label>
                <input type="text" name="logusername" id="username" placeholder="Enter your username" required>
            </div>
            
            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" name="logpassword" id="password" placeholder="Enter your password" required>
            </div>

            <div class="btn-container">
                <input class="button-design" type="submit" value="Login">
                <input class="button-design" type="button" value="Sign Up" onclick="window.location.href='/Signup'">
    
            </div>
        </form>
    </div>
</body>
</html>
