<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JewelryGen</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>

   
    <header>
        <img src="/img/img4.png" alt="JewelryGen Logo" class="logo">
        <h1>JewelryGen</h1>
    </header>

    <main>
        <h2>Generate Your Jewelry Design</h2>
        <div class="input-container">
            <input type="text" placeholder="Enter your design prompt here...">
            <button>Generate Designs</button>
        </div>

        <h3 class="gallery">Your Generated Designs</h3>
        <div class="gallery">
            <div class="design">
                <img src="/img/img1.jpeg" alt="Gold Necklace">
                <button class="save-button">Save Design</button>
            </div>
            <div class="design">
                <img src="/img/img2.jpeg" alt="Silver Earrings">
                <button class="save-button">Save Design</button>
            </div>
            <div class="design">
                <img src="/img/img3.jpeg" alt="Diamond Ring">
                <button class="save-button">Save Design</button>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2023 JewelryGen. All rights reserved. | <a href="#">Contact Us</a> | <a href="#">Privacy Policy</a></p>
    </footer>

</body>
</html>
