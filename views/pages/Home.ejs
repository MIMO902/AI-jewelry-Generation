<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JewelryJinn</title>
    <link rel="stylesheet" href="/css/home.css"> <!-- Link Navbar CSS -->
</head>
<body>

    <%- include("../partials/navbar") %>

    <main>
        <h2>Generate Your Jewelry Design</h2>
        <div class="input-container">
            <form action="/user/generate" method="post">
                <input type="text" name="prompt" id="prompt" placeholder="Enter your design prompt here...">
                <input class="gen-button" type="submit" value="Generate Designs">
            </form>
            <button id="startRecord">Start Recording</button>
            <button id="stopRecord" disabled>Stop Recording</button>
            <p><strong>Transcription:</strong> <span id="transcription"></span></p>
        </div>

        <h3>Your Generated Designs</h3>

        <!-- GALLERY CONTAINER -->
        <div class="gallery">
            <div class="design">
                <% if (generated_images) { %>
                    <% console.log(generated_images[0]) %>
                    <img src="<%=generated_images[0].imagePath%>" alt="Gold Necklace">
                <% } else { %>
                    <img src="/img/img1.jpeg" alt="Gold Necklace">
                <% } %>
                <% if (generated_images) { %>
                    <div class="button-container">
                        <form action="/user/save_image/<%=generated_images[0].id%>" method="post">
                            <input class="save-button" type="submit" value="save">
                        </form>
                        <button class="save-button" onclick="openModal('<%=generated_images[0].imagePath%>')">Edit</button>
                    </div>
                 <% } %>
            </div>

            <div class="design">
                <% if (generated_images) { %>
                    <img src="<%=generated_images[1].imagePath%>" alt="Gold Necklace">
                <% } else { %>
                    <img src="/img/img1.jpeg" alt="Gold Necklace">
                <% } %>
                <% if (generated_images) { %>
                    <div class="button-container">
                        <form action="/user/save_image/<%=generated_images[1].id%>" method="post">
                            <input class="save-button" type="submit" value="save">
                        </form>
                        <button class="save-button" onclick="openModal('<%=generated_images[1].imagePath%>')">Edit</button>
                    </div>
                    <% } %>
            </div>

            <div class="design">
                <% if (generated_images) { %>
                    <img src="<%=generated_images[2].imagePath%>" alt="Gold Necklace">
                <% } else { %>
                    <img src="/img/img1.jpeg" alt="Gold Necklace">
                <% } %>
                <% if (generated_images) { %>
                <div class="button-container">
                    <form action="/user/save_image/<%=generated_images[2].id%>" method="post">
                        <input class="save-button" type="submit" value="save">
                    </form>
                    <button class="save-button" onclick="openModal('<%=generated_images[2].imagePath%>')">Edit</button>
                </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- MODAL POPUP -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close-button" onclick="closeModal()">&times;</span>
            <img id="modalImage" src="" alt="Jewelry Design">
            <textarea id="editPrompt" placeholder="Enter your edit prompt here..."></textarea>
            <button class="modal-save-button">Apply Changes</button>
        </div>
    </div>

    <footer>
        <p>&copy; 2023 JewelryJinn. All rights reserved. | <a href="#">Contact Us</a> | <a href="#">Privacy Policy</a></p>
    </footer>

    <script>
        function openModal(imageSrc) {
            document.getElementById("modalImage").src = imageSrc;
            document.getElementById("editModal").style.display = "flex";
        }

        function closeModal() {
            document.getElementById("editModal").style.display = "none";
        }

        // Close the modal when clicking outside
        window.onclick = function(event) {
            let modal = document.getElementById("editModal");
            if (event.target === modal) {
                closeModal();
            }
        };
    </script>

<script>
    let mediaRecorder;
    let audioChunks = [];

    document.getElementById("startRecord").addEventListener("click", async () => {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];

        mediaRecorder.ondataavailable = event => audioChunks.push(event.data);
        mediaRecorder.onstop = sendAudioToServer;

        mediaRecorder.start();
        document.getElementById("startRecord").disabled = true;
        document.getElementById("stopRecord").disabled = false;
    });

    document.getElementById("stopRecord").addEventListener("click", () => {
        mediaRecorder.stop();
        document.getElementById("startRecord").disabled = false;
        document.getElementById("stopRecord").disabled = true;
    });

    async function sendAudioToServer() {
        const audioBlob = new Blob(audioChunks, { type: "audio/wav" });
        const formData = new FormData();
        formData.append("audio", audioBlob, "recorded.wav");

        const response = await fetch("http://localhost:3000/user/transcribe", {
            method: "POST",
            body: formData,
        });

        const data = await response.json();
        document.getElementById("transcription").innerText = data.transcript || "Failed to transcribe.";
    }
</script>

</body>
</html>
