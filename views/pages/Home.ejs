
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JewelryJinn</title>
    <link rel="stylesheet" href="/css/home.css">
    <script defer src="/js/maskEditor.js"></script>
</head>
<body>
    <%- include("../partials/navbar") %>
    <main>
        <h2>Generate Your Jewelry Design</h2>
        <div class="input-container">
            <form action="/user/generate" method="post">
                <input type="text" name="prompt" id="prompt" placeholder="Enter your design prompt here...">
                <input class="gen-button" type="submit" value="Generate Designs">
            </form>
        </div>
        <h3>Your Generated Designs</h3>
        <div class="gallery">
            <% if (generated_images) { %>
                <% generated_images.forEach((image, index) => { %>
                    <div class="design">
                        <img id="img-<%= index %>" src="data:image/png;base64,<%- image.imageData %>" alt="Jewelry Design">
                        <div class="button-container">
                            <form action="/user/save_image/<%= image.id %>" method="post">
                                <input class="save-button" type="submit" value="Save">
                            </form>
                            <button class="edit-button" onclick="openModal('<%- image.imageData %>', '<%= index %>')">Edit</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No designs generated yet.</p>
            <% } %>
        </div>
    </main>
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close-buttons" onclick="closeModal()">&times;</span>
            <button id="startMask">Start Inpainting</button>
            <button id="redoMask">Redo</button>
            <button id="endMask">End</button>
            <div class="image-container" style="position: relative; display: inline-block;">
                <img id="modalImage" src="" alt="Jewelry Design" style="display: block; max-width: 100%; height: auto;">
                <canvas id="maskCanvas" style="position: absolute; top: 0; left: 0;"></canvas>
            </div>
            <textarea id="editPrompt" placeholder="Enter your edit prompt here..."></textarea>
            <button class="modal-save-button" onclick="applyMask()">Apply Changes</button>
        </div>
    </div>
</body>
</html>
